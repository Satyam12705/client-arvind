{
  "name": "anand-techno-fab-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap:generate && tsc -b && vite build",
    "lint": "oxlint",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "preview": "vite preview",
    "cf:preview": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=client-arvind",
    "db:migrate:local": "wrangler d1 migrations apply anand-techno-fab-content --local",
    "db:migrate:remote": "wrangler d1 migrations apply anand-techno-fab-content --remote",
    "seed:generate": "node scripts/generate-seed.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
